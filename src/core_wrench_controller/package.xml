<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>core_wrench_controller</name>
  <version>0.0.0</version>
  <description>ROS2 wrench controller: WrenchController + WrenchControlNode for force/torque and motion+force hybrid control.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>mav_msgs</depend>
  <depend>base_main_class</depend>
  <depend>core_pid_controller</depend>
  <depend>core_pose_controller</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-ament-index-package</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
